archive/
agents-lab/

# Options under consideration: proposals and assessments not yet decided, kept out of history
# until one is taken up.
options/

# Book build output — regenerated by `make pdf`, never committed.
build/

# Python bytecode. `scripts/check_style.py` imports `scripts/build_book.py`, so running the
# checker writes one of these; a compiled copy of a script is build output like any other.
# `*.pyc` as well as the directory: a stray bytecode file written outside a `__pycache__/`
# would otherwise still show up as a spurious modification in every diff.
__pycache__/
*.pyc

# The review server's virtual environment. cards/standing-defaults.md: dependencies
# never go into system or user Python.
.venv/
